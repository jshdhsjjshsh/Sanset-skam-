    end
    if action == "ChangeSettings" then
        if key == "HideLiveDrop" then
            local hidden = (val == true or tonumber(val) == 1)
            gs.HideLiveDrop = hidden
            _G.HideDrop = hidden
        elseif key == "MusicSound" then
            local volume = math.clamp(tonumber(val) or 0.30, 0, 0.4)
            gs.MusicSound = volume
            local boostedVolume = math.clamp(volume * 1.5, 0, 0.6)
            pcall(function() game:GetService("SoundService").AirSounds.Volume = boostedVolume end)
        elseif key == "EventMusicVolume" then
            gs.EventMusicVolume = math.clamp(tonumber(val) or 0.58, 0, 1)
            pcall(function() local eventMusic = PG:FindFirstChild("SST_EventThemeMusic"); if eventMusic then eventMusic.Volume = gs.EventMusicEnabled and gs.EventMusicVolume or 0 end end)
        elseif key == "EventMusicEnabled" then
            gs.EventMusicEnabled = (val == true or tonumber(val) == 1)
            pcall(function() local eventMusic = PG:FindFirstChild("SST_EventThemeMusic"); if eventMusic then eventMusic.Volume = gs.EventMusicEnabled and (tonumber(gs.EventMusicVolume) or 0.58) or 0 end end)
        elseif key == "SoundEffects" then
            gs.SoundEffects = (val == true or tonumber(val) == 1)
            if not gs.SoundEffects then
                for sound in pairs(activeScriptSounds or {}) do pcall(function() sound:Stop(); sound:Destroy() end) end
                if activeScriptSounds then table.clear(activeScriptSounds) end
            end
        elseif key == "SoundEffectsVolume" then
            gs.SoundEffectsVolume = math.clamp(tonumber(val) or 0.70,0,1)
            for sound, baseVolume in pairs(activeScriptSounds or {}) do pcall(function() sound.Volume = (tonumber(baseVolume) or 1) * gs.SoundEffectsVolume end) end
        elseif key == "Snow" then
            gs.Snow = (val == true or tonumber(val) == 1)
        else
            return nil
        end
        SAVE.settings()
        return true
    end
end

