local function injectLB()
    if _lbInjectBusy or _lbThemeRebuilding then return end
    _lbInjectBusy = true
    local function finishLB() _lbInjectBusy = false end
    local ok, err = pcall(function()
        local LB = RS:FindFirstChild("Leaderboards")
        if not LB then return end
        local starsFolder = LB:FindFirstChild("Stars")
        local gemsFolder = LB:FindFirstChild("Gems")
        local tonFolder = LB:FindFirstChild("TON")
        local invFolder = LB:FindFirstChild("Inv")
        if not (starsFolder or gemsFolder or tonFolder or invFolder) then return end

        syncGameStatAttributes()
        local myStars = math.max(0, math.floor(tonumber(getBal("_StarsValue")) or 0))
        local myGems = math.max(0, math.floor(tonumber(getBal("_GemsValue")) or 0))
        local myTON = math.max(0, math.floor(tonumber(getBal("_TONValue")) or 0))
        local myCases, myUpgrades = readGameStat("_CasesOpened"), readGameStat("_UpgradesMade")
        -- The inventory cache is invalidated by ChildAdded/ChildRemoved; an idle
        -- leaderboard refresh does not repeatedly walk thousands of NFT instances.
        if _restoringInventory then return end
        local myInv, counts, totalNFTs = getInventoryStats()
        local bestRef = getBestRef()
        local bestName = bestRef and tostring(bestRef.Value) or "—"

        local function updateProfileData(entry)
            entry:SetAttribute("PlayerID", LP.UserId)
            entry:SetAttribute("Stars", myStars)
            entry:SetAttribute("Gems", myGems)
            entry:SetAttribute("TON", myTON)
            entry:SetAttribute("CasesOpened", myCases)
            entry:SetAttribute("UpgradesMade", myUpgrades)
            entry:SetAttribute("BestDrop", bestName)
            entry:SetAttribute("InventoryValue", myInv)
            entry:SetAttribute("NFTCount", totalNFTs)

            local present = {}
            for _, child in ipairs(entry:GetChildren()) do
                if child:IsA("IntValue") then
                    local wanted = counts[child.Name]
                    if wanted and wanted > 0 then
                        child.Value = wanted
                        present[child.Name] = true
                    else
                        child:Destroy()
                    end
                end
            end
            for name, qty in pairs(counts) do
                if not present[name] then
                    local value = Instance.new("IntValue")
                    value.Name, value.Value, value.Parent = name, qty, entry
                end
            end
        end

        local boardVisuals = {
            Stars = {list="Balance", symbol="⭐ "},
            Gems = {list="BalanceGems", symbol="💎 "},
            TON = {list="BalanceTON", symbol="💠 "},
            Inv = {list="Inventory", symbol="⭐ "},
        }
        local function formatScore(value)
            local formatted = tostring(math.floor(tonumber(value) or 0))
            while true do
                local nextText, n = formatted:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
                formatted = nextText
                if n == 0 then break end
            end
            return formatted
        end
        local function syncLeaderboardVisuals(folder, entries)
            local visual = boardVisuals[folder.Name]
            if not visual then return end
            local mainGui = PG:FindFirstChild("MainGui")
            local pages = mainGui and mainGui:FindFirstChild("Pages")
            local page = pages and pages:FindFirstChild("Leaderboards")
            local mainFrame = page and page:FindFirstChild("MainFrame")
            local list = mainFrame and mainFrame:FindFirstChild(visual.list)
            if not list then return end

            local rankById, scoreById = {}, {}
            for rank, entry in ipairs(entries) do
                local id = tonumber(entry:GetAttribute("PlayerID"))
                if id then
                    rankById[id] = rank
                    scoreById[id] = tonumber(entry.Value) or 0
                end
            end
            local seenRows = {}
            for _, row in ipairs(list:GetChildren()) do
                if row:IsA("Frame") then
                    local avatar = row:FindFirstChild("Avatar")
                    local image = avatar and tostring(avatar.Image or "") or ""
                    local playerId = tonumber(image:match("id=(%d+)"))
                    local rank = playerId and rankById[playerId]
                    if playerId and (_lbHiddenPlayers[playerId] or seenRows[playerId] or not rank) then
                        row:Destroy()
                    elseif playerId and rank then
                        seenRows[playerId] = true
                        row.LayoutOrder = rank
                        local count = row:FindFirstChild("Count")
                        if count then
                            count.Text = "#"..tostring(rank)
                            local podium = {Color3.new(1,0.976471,0.235294), Color3.new(0.607843,0.85098,1), Color3.new(1,0.772549,0.403922)}
                            count.TextColor3 = rank <= 3 and podium[rank] or C.text
                        end
                        local balance = row:FindFirstChild("Balance")
                        if balance then balance.Text = visual.symbol..formatScore(scoreById[playerId]) end
                    end
                end
            end
        end

        local function upsertRanked(folder, score, isInventory)
            if not folder then return end
            local mine, byPlayer = nil, {}
            for _, entry in ipairs(folder:GetChildren()) do
                if entry:IsA("IntValue") then
                    local id = tonumber(entry:GetAttribute("PlayerID"))
                    if not id or _lbHiddenPlayers[id] then
                        entry:Destroy()
                    elseif id == LP.UserId then
                        if not mine then mine = entry else entry:Destroy() end
                    elseif byPlayer[id] then
                        entry:Destroy()
                    else
                        byPlayer[id] = entry
                    end
                end
            end
            local eligible = (isInventory and next(counts) ~= nil) or score > 0
            if eligible then
                if not mine then
                    mine = Instance.new("IntValue")
                    mine:SetAttribute("PlayerID", LP.UserId)
                end
                mine.Value = math.clamp(math.floor(score), 0, 9000000000000000000)
                updateProfileData(mine)
            elseif mine then
                mine:Destroy()
                mine = nil
            end

            local entries = {}
            for _, entry in pairs(byPlayer) do table.insert(entries, entry) end
            if mine then table.insert(entries, mine) end
            table.sort(entries, function(a, b)
                local av, bv = tonumber(a.Value) or 0, tonumber(b.Value) or 0
                if av == bv then
                    return (tonumber(a:GetAttribute("PlayerID")) or 0) < (tonumber(b:GetAttribute("PlayerID")) or 0)
                end
                return av > bv
            end)

            -- First free every old rank name, then assign final names. New local rows
            -- are parented only after their final numeric rank is ready, so the game's
            -- ChildAdded renderer never briefly creates a row named "IntValue".
            for index, entry in ipairs(entries) do
                entry.Name = "_sst_rank_tmp_"..tostring(index).."_"..tostring(tonumber(entry:GetAttribute("PlayerID")) or 0)
            end
            for index, entry in ipairs(entries) do
                entry.Name = tostring(index)
                if entry.Parent ~= folder then entry.Parent = folder end
            end

            syncLeaderboardVisuals(folder, entries)
            -- The native renderer performs an asynchronous username lookup after ChildAdded.
            -- Repaint after it finishes to remove duplicate rows and correct rank/value labels.
            task.delay(0.25, function() pcall(syncLeaderboardVisuals, folder, entries) end)
            task.delay(0.8, function() pcall(syncLeaderboardVisuals, folder, entries) end)
        end

        upsertRanked(starsFolder, myStars, false)
        upsertRanked(gemsFolder, myGems, false)
        upsertRanked(tonFolder, myTON, false)
        upsertRanked(invFolder, myInv, true)
    end)
    finishLB()
    if not ok then warn("[SST50.4] leaderboard refresh failed: "..tostring(err)) end
end

