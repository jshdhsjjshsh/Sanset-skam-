-- Adaptive optimizer 50.9: low-allocation frame sampling and cached memory metrics.
-- No per-call lookup tables; memory is sampled infrequently and tiers require stable windows.
local RunService = game:GetService("RunService")
pcall(function()
    local previous = _G.SunsetSisiOptimizer
    if previous and previous._connection then previous._connection:Disconnect() end
end)
local SSTOptimizer = {
    Enabled=true, Tier="Balanced", RefreshInterval=7, MemoryMB=0, FrameMS=0,
    Samples=0, SlowFrames=0, SlowFrameRatio=0, _elapsed=0, _frameSum=0,
    _frameCount=0, _slowCount=0, _memoryElapsed=0, _candidateTier=nil,
    _candidateCount=0, _started=os.clock(), _connection=nil
}
_G.SunsetSisiOptimizer = SSTOptimizer
function SSTOptimizer:SetEnabled(enabled)
    self.Enabled = enabled == true
    if self._connection then self._connection:Disconnect(); self._connection=nil end
    if self.Enabled then
        self._elapsed, self._frameSum, self._frameCount, self._slowCount = 0, 0, 0, 0
        self._memoryElapsed, self._candidateTier, self._candidateCount = 0, nil, 0
        self.Samples, self.SlowFrames = 0, 0
        pcall(function() self.MemoryMB = gcinfo()/1024 end)
        self._connection = RunService.Heartbeat:Connect(function(dt)
            if type(dt) ~= "number" or dt ~= dt or dt <= 0 or dt > 1 then return end
            self.Samples = self.Samples + 1
            self._elapsed = self._elapsed + dt
            self._frameSum = self._frameSum + dt
            self._frameCount = self._frameCount + 1
            if dt >= (1/30) then
                self._slowCount = self._slowCount + 1
                self.SlowFrames = self.SlowFrames + 1
            end
            if self._elapsed < 3 then return end
            local elapsed = self._elapsed
            if self._frameCount > 0 then
                self.FrameMS = (self._frameSum / self._frameCount) * 1000
                self.SlowFrameRatio = self._slowCount / self._frameCount
            end
            self._elapsed, self._frameSum, self._frameCount, self._slowCount = 0, 0, 0, 0
            self._memoryElapsed = self._memoryElapsed + elapsed
            if self._memoryElapsed >= 12 then
                pcall(function() self.MemoryMB = gcinfo()/1024 end)
                self._memoryElapsed = 0
            end
            self:Recalculate()
        end)
        self:Recalculate(true)
    else
        self.Tier="Off"; self.RefreshInterval=1.0
        self.SlowFrameRatio=0; self._candidateTier=nil; self._candidateCount=0
    end
end
function SSTOptimizer:Interval(kind)
    local base = 2
    if kind == "leaderboard" then base = 7
    elseif kind == "inventory" then base = 5
    elseif kind == "balances" then base = 1.8
    elseif kind == "logs" then base = 4.5
    elseif kind == "profile" then base = 2.5 end
    if not self.Enabled then return base end
    local scale = 1
    if self.Tier == "Eco" then scale = 2.2
    elseif self.Tier == "Conserve" then scale = 1.5
    elseif self.Tier == "Fast" then scale = 0.82 end
    return math.max(0.8, base * scale)
end
function SSTOptimizer:BatchSize(kind)
    local base = 8
    if kind == "restore" then base = 40
    elseif kind == "picker" then base = 12
    elseif kind == "ui" then base = 8
    elseif kind == "particles" then base = 5 end
    if not self.Enabled then return base end
    if self.Tier == "Eco" then return math.max(2, math.floor(base * 0.4)) end
    if self.Tier == "Conserve" then return math.max(3, math.floor(base * 0.65)) end
    if self.Tier == "Fast" then return math.min(32, math.floor(base * 1.5)) end
    return base
end
function SSTOptimizer:ParticleBudget()
    if not self.Enabled or self.Tier == "Eco" then return 2 end
    if self.Tier == "Conserve" then return 3 end
    if self.Tier == "Fast" then return 8 end
    return 5
end
function SSTOptimizer:Recalculate()
    if not self.Enabled then return end
    local mem = self.MemoryMB
    local target = "Balanced"
    if self.Samples >= 120 then
        if mem > 540 or self.FrameMS > 47 or self.SlowFrameRatio > 0.48 then target = "Eco"
        elseif mem > 380 or self.FrameMS > 34 or self.SlowFrameRatio > 0.28 then target = "Conserve"
        elseif self.FrameMS < 18 and mem < 300 and self.SlowFrameRatio < 0.07 then target = "Fast" end
    end
    -- Two consecutive 3-second windows are required before changing quality tier.
    if target ~= self.Tier then
        if self._candidateTier == target then
            self._candidateCount = self._candidateCount + 1
        else
            self._candidateTier, self._candidateCount = target, 1
        end
        if self._candidateCount >= 2 then
            self.Tier = target
            self._candidateTier, self._candidateCount = nil, 0
        end
    else
        self._candidateTier, self._candidateCount = nil, 0
    end
    self.RefreshInterval = self:Interval("leaderboard")
end
function SSTOptimizer:GetMetrics()
    -- Return cached memory: opening the optimizer panel must not trigger gcinfo().
    local mem = self.MemoryMB
    return {
        Enabled=self.Enabled, Tier=self.Tier,
        MemoryMB=math.floor(mem*10)/10,
        FrameMS=math.floor(self.FrameMS*10)/10,
        Samples=self.Samples, SlowFrames=self.SlowFrames,
        SlowFrameRatio=math.floor(self.SlowFrameRatio*1000)/10,
        Uptime=os.clock()-self._started, Refresh=self.RefreshInterval
    }
end
SSTOptimizer:SetEnabled(true)

