local function getInventoryStats()
    if _inventoryStatsDirty then
        local totalValue, totalCount, counts = 0, 0, {}
        for _, item in ipairs(ensureInv():GetChildren()) do
            local gift = Info.Gifts and Info.Gifts[item.Name]
            if gift then
                local price = math.max(0, tonumber(gift.Price) or 0)
                totalValue = totalValue + price
                totalCount = totalCount + 1
                counts[item.Name] = (counts[item.Name] or 0) + 1
            end
        end
        _inventoryStatsCache = {value=totalValue, counts=counts, total=totalCount}
        _inventoryStatsDirty = false
    end
    return _inventoryStatsCache.value, _inventoryStatsCache.counts, _inventoryStatsCache.total
end
local function normNum(n)
    if n == nil then return "Collectible #" .. tostring(math.random(1, 999999)) end
    if type(n) == "number" then return "Collectible #" .. tostring(math.floor(n)) end
    local s = tostring(n)
    if s:find("Collectible", 1, true) then return s end
    if s:match("^%d+$") then return "Collectible #" .. s end
    return s
end
