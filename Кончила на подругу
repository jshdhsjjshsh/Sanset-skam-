            end

            -- Use the picker entry's own image only after checking the exact gift record.
            local supplied = item and (item.image or item.Image)
            if type(supplied) == "number" then
                return supplied > 0 and ("rbxassetid://"..tostring(supplied)) or nil
            end
            if type(supplied) == "string" and supplied ~= "" then
                if supplied:find("rbxassetid://", 1, true) == 1 then return supplied end
                if supplied:match("^%d+$") then return "rbxassetid://"..supplied end
            end

            -- Fallback aliases are limited to the item name; never inspect a display label
            -- that may be shared or decorated by another NFT.
            local lowerName = string.lower(itemName)
            if lowerName:find("pin", 1, true) and lowerName:find("cursed", 1, true) then return MENU_NAMED_IMAGES["Pin Cursed"] end
