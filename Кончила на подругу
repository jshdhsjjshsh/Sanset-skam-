local function weightedPick(weights)
    if type(weights) ~= "table" then return nil end
    local total, names = 0, {}
    for name, w in pairs(weights) do w = tonumber(w) or 0; if w > 0 then table.insert(names, name); total = total + w end end
    if total <= 0 then return nil end
    local r = math.random() * total; local acc = 0
    for _, name in ipairs(names) do acc = acc + (tonumber(weights[name]) or 0); if r <= acc then return name end end
    return names[#names]
end
local function giveReward(rw)
    if not rw or not rw[1] then return end
    local tp, amt = rw[1], rw[2]
    if tp == "NFT" then local chosen = weightedPick(amt); if chosen then spawnNFT(chosen, {isUnique=false}) end
    else
        local n = tonumber(amt) or 0
        if n <= 0 then return end
        if tp == "x2Luck" then forceAddBuff("_LuckyPotion", n)
        elseif tp == "x4Luck" then forceAddBuff("_LuckyPotion2", n)
        elseif tp == "x6Luck" then forceAddBuff("_LuckyPotion3", n)
        elseif tp == "Blessing" then forceAddBuff("_Blessing", n)
        elseif tp == "Stars" then addBal("_StarsValue", n)
        elseif tp == "Gems" then addBal("_GemsValue", n)
        elseif tp == "Tons" then addBal("_TONValue", n) end
    end
end

local _caseDropCache = setmetatable({}, {__mode="k"})
local function getBaseDropEntries(cfg)
    local drop = cfg and cfg.Drop
    if type(drop) ~= "table" or #drop == 0 then return nil end
    local cached = _caseDropCache[cfg]
    if cached and cached.drop == drop and cached.count == #drop then return cached.entries end
    local entries = {}
    for _, entry in ipairs(drop) do
        if type(entry) == "table" and type(entry[1]) == "string" and Info.Gifts[entry[1]] then
            local weight = safeNumber(entry[2], 0, 0, 1e12)
            if weight > 0 then
                local gift = Info.Gifts[entry[1]]
                local price = safeNumber(gift and gift.Price, 0, 0, MAX_LOCAL_VALUE)
                entries[#entries + 1] = {
                    name=entry[1], baseWeight=weight,
                    rarity=math.clamp(math.log10(price + 1) / 6, 0, 1)
                }
            end
        end
    end
    _caseDropCache[cfg] = {drop=drop, count=#drop, entries=entries}
    return entries
end
local function rollDrop(cfg)
    local entries = getBaseDropEntries(cfg)
    if not entries or #entries == 0 then return nil end

    -- The case's static weights/prices are cached; only current luck multipliers
    -- are calculated per roll. No temporary weighted table is allocated.
    local luck = math.max(1, getLuck())
    local luckPower = math.max(0, luck - 1)
    local blessingBoost = hasBlessing() and 1.35 or 1
    local total = 0
    for _, entry in ipairs(entries) do
        total = total + entry.baseWeight * (1 + luckPower * (0.15 + entry.rarity * 1.85)) * blessingBoost
    end
    if total <= 0 then return nil end
    local roll, accumulated = math.random() * total, 0
    for _, entry in ipairs(entries) do
        accumulated = accumulated + entry.baseWeight * (1 + luckPower * (0.15 + entry.rarity * 1.85)) * blessingBoost
        if roll <= accumulated then return entry.name end
    end
    return entries[#entries].name
end

