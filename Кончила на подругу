local _restoringInventory = false
local function addNormal(name, favorite, spawnId)
    if not Info.Gifts[name] then return end
    local data = _nfts[name]
    if type(data) ~= "table" then data = {count=0, items={}}; _nfts[name] = data end
    data.items = type(data.items)=="table" and data.items or {}
    data.count = (tonumber(data.count) or #data.items) + 1
    table.insert(data.items, {id=tostring(spawnId or ("legacy-"..tostring(data.count).."-"..tostring(os.time()))), favorite=favorite==true})
    data.favorite = nil -- old group-wide flag caused every copy to become favorite
    if _inventoryBatch then
        _inventoryBatch.normal = true
        if not _restoringInventory then _inventoryBatch.index[name] = (_inventoryBatch.index[name] or 0) + 1 end
    else
        SAVE.normal(); if not _restoringInventory then updateIndex(name, 1) end
    end
end
local function removeNormal(name, spawnId)
    local data = _nfts[name]
    if type(data) ~= "table" then return false end
    data.items = type(data.items)=="table" and data.items or {}
    local found
    for i=#data.items,1,-1 do
        if tostring(data.items[i].id)==tostring(spawnId) then table.remove(data.items,i); found=true; break end
    end
    if not found and #data.items > 0 then table.remove(data.items, #data.items); found=true end
    if not found then return false end
    data.count = math.max(0, (tonumber(data.count) or (#data.items+1))-1)
    if data.count == 0 or #data.items == 0 then _nfts[name] = nil else data.count = #data.items end
    if _inventoryBatch then
        _inventoryBatch.normal = true
        _inventoryBatch.index[name] = (_inventoryBatch.index[name] or 0) - 1
    else
        SAVE.normal(); updateIndex(name, -1)
    end
    return true
end
local function addUnique(name, data)
    if not Info.Gifts[name] then return end
    if not _uniques[name] then _uniques[name] = {} end
    table.insert(_uniques[name], {id=tostring(data.id or ("unique-"..tostring(os.time()).."-"..tostring(#_uniques[name]+1))), owner=LP.Name, model=name, pattern=data.pattern, backdrop=data.backdrop, date=os.date("%m/%d/%Y"), number=data.number, favorite=data.favorite==true})
    if _inventoryBatch then
        _inventoryBatch.unique = true
        if not _restoringInventory then _inventoryBatch.index[name] = (_inventoryBatch.index[name] or 0) + 1 end
    else
        SAVE.unique(); if not _restoringInventory then updateIndex(name, 1) end
    end
end
local function removeUnique(name, pattern, backdrop, number, spawnId)
    if not _uniques[name] then return false end
    for i = #_uniques[name], 1, -1 do
        local d = _uniques[name][i]
        local match = spawnId and tostring(d.id)==tostring(spawnId) or (not spawnId and d.pattern == pattern and d.backdrop == backdrop and d.number == number)
        if match then
            table.remove(_uniques[name], i)
            if #_uniques[name] == 0 then _uniques[name] = nil end
            if _inventoryBatch then
                _inventoryBatch.unique = true
                _inventoryBatch.index[name] = (_inventoryBatch.index[name] or 0) - 1
            else
                SAVE.unique(); updateIndex(name, -1)
            end
            return true
        end
    end
    return false
end
