            local new = Instance.new("IntValue"); new.Name = tostring(i); new.Value = myVal
            pcall(function() new:SetAttribute("PlayerID", LP.UserId) end); new.Parent = folder
        end
    end
    pcall(upsert, stars, myStars); pcall(upsert, inv, myInv)
