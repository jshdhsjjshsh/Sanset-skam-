            v.Name = e.name; v.Value = e.value or ""
            for k, val in pairs(e) do
                if type(k)=="string" and k:sub(1,2)=="__" then pcall(function() v:SetAttribute(k:sub(3), val) end) end
            end
            v.Parent = histR
        end
    end

    local mktR = LP:FindFirstChild("_Market")
    if mktR then
        for _, c in ipairs(mktR:GetChildren()) do pcall(function() c:Destroy() end) end
        for _, e in ipairs(CloneX.market or {}) do
