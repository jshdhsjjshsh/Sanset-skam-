local function nameHash(name)
    local h = 5381
    for i = 1, #name do h = (h * 33 + name:byte(i)) % 1000000000 end
    return h + 1
end
local function avatarUrl(uid, name)
    local useUid = tonumber(uid) or 0
    if useUid <= 0 then useUid = nameHash(tostring(name or "Fake")) end
    return "rbxthumb://type=AvatarHeadShot&id="..useUid.."&w=150&h=150"
end

