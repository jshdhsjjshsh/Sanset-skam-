end

local function addClickAnimation(btn)
    if not btn then return end
    btn.MouseButton1Down:Connect(function(x, y)
        local ripple = New("Frame", {
            AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(0,x,0,y),
            Size=UDim2.new(0,0,0,0), BackgroundColor3=Color3.new(1,1,1),
            BackgroundTransparency=0.55, BorderSizePixel=0,
            ZIndex=(btn.ZIndex or 1)+100, Parent=btn,
        })
        if not ripple then return end
        corner(ripple, 9999)
        local maxDim = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2
        if maxDim <= 0 then maxDim = 200 end
        TweenS:Create(ripple, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size=UDim2.new(0,maxDim,0,maxDim), BackgroundTransparency=1,
        }):Play()
        Debris:AddItem(ripple, 0.6)
    end)
    local bounce = Instance.new("UIScale", btn); bounce.Scale = 1
    btn.MouseButton1Down:Connect(function()
        TweenS:Create(bounce, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale=0.92}):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        TweenS:Create(bounce, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale=1}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenS:Create(bounce, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale=1}):Play()
    end)
end

local function makeButton(parent, props, radius)
    props = props or {}
    if props.BackgroundTransparency == nil then props.BackgroundTransparency = 0.05 end
    props.BorderSizePixel = 0
    if not props.TextColor3 then props.TextColor3 = C.text end
    props.AutoButtonColor = false; props.Parent = parent
    local base = props.BackgroundTransparency
    local b = New("TextButton", props)
    if not b then return nil end
    corner(b, radius or S.rMd)
    local st = stroke(b, C.neonBr, 1, 0.25)
    addClickAnimation(b)
    b.MouseEnter:Connect(function()
        TweenS:Create(b, TweenInfo.new(0.15), {BackgroundTransparency=math.max(0, base-0.12)}):Play()
        if st then TweenS:Create(st, TweenInfo.new(0.15), {Transparency=0.05}):Play() end
    end)
    b.MouseLeave:Connect(function()
        TweenS:Create(b, TweenInfo.new(0.15), {BackgroundTransparency=base}):Play()
        if st then TweenS:Create(st, TweenInfo.new(0.15), {Transparency=0.25}):Play() end
    end)
    b.MouseButton1Down:Connect(function()
        TweenS:Create(b, TweenInfo.new(0.08), {BackgroundTransparency=math.max(0, base-0.25)}):Play()
    end)
    b.MouseButton1Up:Connect(function()
        TweenS:Create(b, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency=math.max(0, base-0.12)}):Play()
    end)
    return b
end

