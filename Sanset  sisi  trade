    local balKey = CUR2BAL[curKey]
    local sym = balKey and SYM[balKey] or ""
    local lbl = item:FindFirstChildOfClass("TextLabel")
    if not lbl then for _, d in ipairs(item:GetDescendants()) do if d:IsA("TextLabel") then lbl = d; break end end end
    if lbl then
        lbl.Text = sym..fullNum(value)
        lbl.TextWrapped = false
        lbl.TextXAlignment = Enum.TextXAlignment.Center
        lbl.TextYAlignment = Enum.TextYAlignment.Center
        lbl.TextScaled = true
        local oldC = lbl:FindFirstChildOfClass("UITextSizeConstraint"); if oldC then oldC:Destroy() end
        local c = Instance.new("UITextSizeConstraint"); c.MaxTextSize = 12; c.MinTextSize = 4; c.Parent = lbl
    end
end

local function rebuildOffScroll(R, S)
    if not R.OffScroll then return end
    local counted = {}
    for _, inst in ipairs(S.MyOfferItems) do
        if inst and not inst:GetAttribute("Unique") then counted[inst.Name] = (counted[inst.Name] or 0) + 1 end
    end
    for _, c in ipairs(R.OffScroll:GetChildren()) do if c:IsA("Frame") and c.Name~="Add" then c:Destroy() end end
    if R.TmplD then
        for name, cnt in pairs(counted) do
            local slot = R.TmplD:Clone(); slot.Name = name; paintGift(slot, name)
            local c = slot:FindFirstChild("Counter"); if c then c.Value = cnt end
            local f = slot:FindFirstChild("Folder"); local c2 = f and f:FindFirstChild("Count"); if c2 then c2.Text = "x"..cnt end
            local b = slot:FindFirstChild("Button"); if b then b:Destroy() end
            slot.Parent = R.OffScroll
        end
    end
    if R.TmplU then
        for _, inst in ipairs(S.MyOfferItems) do
            if inst and inst:GetAttribute("Unique") then
                local slot = R.TmplU:Clone()
                slot.Name = inst.Name.."_"..tostring(math.random(1,9999))
                slot:SetAttribute("Unique", true); paintGift(slot, inst.Name); paintUnique(slot, inst)
                local b = slot:FindFirstChild("Button"); if b then b:Destroy() end
                slot.Parent = R.OffScroll
            end
        end
    end
    if R.OffCurr and R.TmplC then
        clearCurrency(R.OffCurr)
        for k, v in pairs(S.MyOfferCur) do addCurrencyTo(R.OffCurr, k, v, R.TmplC) end
    end
end

StartFakeTrade = function(partnerPlayer)
    if Fake and Fake.gui and Fake.gui.Parent then Fake.gui:Destroy() end
    Fake = nil
    if not partnerPlayer then return end
    local isFake = (type(partnerPlayer)=="table") and (partnerPlayer.IsFake==true)
    local isReal = (typeof(partnerPlayer)=="Instance") and partnerPlayer:IsA("Player") and partnerPlayer.Parent ~= nil
    if not isFake and not isReal then return end
    local tmpl = SG:FindFirstChild("TradeGui") or PG:FindFirstChild("TradeGui")
    if not tmpl then return end
    local gui = tmpl:Clone()
    gui.Name="TradePlazaX_Fake"; gui.Enabled=true; gui.ResetOnSpawn=false; gui.DisplayOrder=800
    for _, d in ipairs(gui:GetDescendants()) do if d:IsA("LocalScript") then d.Disabled = true end end
    gui.Parent = PG
    if MainGui and MainGui.Parent then MainGui.DisplayOrder = 950 end
    local R = refsOf(gui); if not R then gui:Destroy(); return end
    local S = {
        PendingItems={}, PendingUniq={}, PendingCur={StarsValue=0,TONValue=0,GemsValue=0},
        MyOfferItems={}, MyOfferCur={StarsValue=0,TONValue=0,GemsValue=0},
        TheirOfferItems={}, TheirOfferCur={StarsValue=0,TONValue=0,GemsValue=0},
        Confirmed=false, PartnerConfirmed=false, Busy=false, Closed=false, Cancelled=false,
        Inited=false, CancelConfirm=false, InvCounters={}, InvUniqs={},
    }
    Fake = { gui=gui, refs=R, player=partnerPlayer, S=S }
    FAKE_TRADE_PARTNER = partnerPlayer.Name or partnerPlayer.DisplayName
    addLog("FAKE_TRADE_START", tostring(FAKE_TRADE_PARTNER))

    if R.Heading then local t = R.Heading:FindFirstChild("Txt"); if t then t.Text = "Trading with "..(partnerPlayer.Name or "Player") end end

    local function getStroke(frame)
        if not frame then return nil end
        for _, c in ipairs(frame:GetChildren()) do if c:IsA("UIStroke") then return c end end
    end
    local function applyTradeGray(container)
        if not container then return end
        local s = getStroke(container)
        if not s then s = Instance.new("UIStroke"); s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = container end
        s.Color = C.tradeGray; s.Thickness = 2; s.Transparency = 0.2
        for _, c in ipairs(s:GetChildren()) do if c:IsA("UIGradient") then c:Destroy() end end
    end
    applyTradeGray(R.Offering); applyTradeGray(R.Receiving)
    local offStroke = getStroke(R.Offering); local recStroke = getStroke(R.Receiving)
    if R.Confirm then local t = R.Confirm:FindFirstChild("Txt"); if t then t.Text = "Confirm" end end
    if R.Progress then R.Progress.Visible = false end
    clearScroll(R.OffScroll, true); clearScroll(R.RecScroll, false)
    clearCurrency(R.OffCurr); clearCurrency(R.RecCurr)
    if R.AddWindow then R.AddWindow.Visible = false end
    if R.TradeWindow then R.TradeWindow.Visible = true end

    local function initInventory()
        if S.Inited then return end
        S.Inited = true
        clearScroll(R.Inv and R.Inv:FindFirstChild("Scroll1"), false)
        clearScroll(R.Inv and R.Inv:FindFirstChild("Scroll2"), false)
        clearScroll(R.SelScroll, false)
        local counts, uniqs = {}, {}
        for _, it in ipairs(_Inventory:GetChildren()) do
            if it:GetAttribute("Unique") then table.insert(uniqs, it)
            else counts[it.Name] = (counts[it.Name] or 0) + 1 end
        end
        local s1 = R.Inv and R.Inv:FindFirstChild("Scroll1")
        if s1 and R.TmplD then
            for name, cnt in pairs(counts) do
                local slot = R.TmplD:Clone(); slot.Name = name; paintGift(slot, name)
                local counter = slot:FindFirstChild("Counter")
                local folder = slot:FindFirstChild("Folder")
                local countLbl = folder and folder:FindFirstChild("Count")
                if counter then counter.Value = cnt end
                if countLbl then countLbl.Text = "x"..cnt end
                slot.Parent = s1
                S.InvCounters[name] = {slot=slot, counter=counter, total=cnt, countLbl=countLbl}
                local btn = slot:FindFirstChild("Button")
                if btn then
                    btn.Activated:Connect(function()
                        if S.Busy or S.Closed or S.Confirmed then return end
                        if not counter or counter.Value <= 0 then play(SND.Error); return end
                        local target
                        for _, inv in ipairs(_Inventory:GetChildren()) do
                            if inv.Name == name and not inv:GetAttribute("Unique") and not S.PendingItems[inv] then target = inv; break end
                        end
                        if not target then play(SND.Error); return end
                        S.PendingItems[target] = true
                        counter.Value = counter.Value - 1
                        if countLbl then countLbl.Text = "x"..counter.Value end
                        if counter.Value == 0 then slot.Visible = false end
                        play(SND.Click)
                        if R.SelScroll then
                            local dname = "D!"..name
                            local ex = R.SelScroll:FindFirstChild(dname)
                            if ex then
                                local ec = ex:FindFirstChild("Counter"); if ec then ec.Value = ec.Value + 1 end
                                local ef = ex:FindFirstChild("Folder"); local ec2 = ef and ef:FindFirstChild("Count"); if ec2 and ec then ec2.Text = "x"..ec.Value end
                            else
                                local dup = slot:Clone(); dup.Name = dname; dup.Visible = true
                                local dc = dup:FindFirstChild("Counter"); if dc then dc.Value = 1 end
                                local df = dup:FindFirstChild("Folder"); local dcf = df and df:FindFirstChild("Count"); if dcf then dcf.Text = "x1" end
                                local ob = dup:FindFirstChild("Button"); if ob then ob:Destroy() end
                                local cb = Instance.new("TextButton"); cb.Name="Btn"; cb.Size=UDim2.new(1,0,1,0)
                                cb.BackgroundTransparency=1; cb.Text=""; cb.AutoButtonColor=false; cb.Parent=dup
                                cb.Activated:Connect(function()
                                    if S.Confirmed or S.Closed then return end
                                    local inst
                                    for sel in pairs(S.PendingItems) do if sel.Name == name and not sel:GetAttribute("Unique") then inst = sel end end
                                    if inst then
                                        S.PendingItems[inst] = nil
                                        if counter then
                                            counter.Value = counter.Value + 1
                                            if countLbl then countLbl.Text = "x"..counter.Value end
                                            slot.Visible = true
                                        end
                                    end
                                    local dc2 = dup:FindFirstChild("Counter")
                                    local df2 = dup:FindFirstChild("Folder")
                                    local dc3 = df2 and df2:FindFirstChild("Count")
                                    if dc2 and dc2.Value > 1 then dc2.Value = dc2.Value - 1; if dc3 then dc3.Text = "x"..dc2.Value end
                                    else dup:Destroy() end
                                    play(SND.Click)
                                end)
                                dup.Parent = R.SelScroll
                            end
                        end
                    end)
                end
            end
        end
        local s2 = R.Inv and R.Inv:FindFirstChild("Scroll2")
        if s2 and R.TmplU then
            for _, inst in ipairs(uniqs) do
                local slot = R.TmplU:Clone()
                slot.Name = inst.Name; slot:SetAttribute("Unique", true)
                paintGift(slot, inst.Name); paintUnique(slot, inst)
                slot.Parent = s2; S.InvUniqs[inst] = slot
                local btn = slot:FindFirstChild("Button")
                if btn then
                    btn.Activated:Connect(function()
                        if S.Busy or S.Closed or S.Confirmed then return end
                        if S.PendingUniq[inst] then return end
                        S.PendingUniq[inst] = true; slot.Visible = false; play(SND.Click)
                        if R.SelScroll then
                            local dup = slot:Clone(); dup.Visible = true; dup.Name = "SU_"..tostring(math.random(1000,9999))
                            local ob = dup:FindFirstChild("Button"); if ob then ob:Destroy() end
                            local cb = Instance.new("TextButton"); cb.Name="Btn"; cb.Size=UDim2.new(1,0,1,0)
                            cb.BackgroundTransparency=1; cb.Text=""; cb.AutoButtonColor=false; cb.Parent=dup
                            cb.Activated:Connect(function()
                                if S.Confirmed or S.Closed then return end
                                S.PendingUniq[inst] = nil; slot.Visible = true; dup:Destroy(); play(SND.Click)
                            end)
                            dup.Parent = R.SelScroll
                        end
                    end)
                end
            end
        end
        if R.SelCurr then
            for _, curFrame in ipairs({"StarsValue","TONValue","GemsValue"}) do
                local frame = R.SelCurr:FindFirstChild(curFrame)
                if frame then
                    local box = frame:FindFirstChildOfClass("TextBox")
                    if box then
                        box.FocusLost:Connect(function()
                            if S.Confirmed or S.Closed then return end
                            local v = parseNumber(box.Text)
                            local balKey = CUR2BAL[curFrame]
                            local bal = balKey and BAL[balKey]
                            if v and v > 0 then
                                if bal and bal.Value < v then v = bal.Value; notify("ERROR","Not enough "..curFrame); play(SND.Error) end
                                frame:SetAttribute("Amount", v)
                                S.PendingCur[curFrame] = v
                                box.Text = (SYM[balKey] or "").." "..fullNum(v)
                                play(SND.Tick)
                            end
                        end)
                    end
                end
            end
        end
    end
    initInventory()

    if R.Cancel then
        R.Cancel.Activated:Connect(function()
            if S.Busy or S.Closed then return end
            S.Busy=true; task.delay(0.3,function() S.Busy=false end); play(SND.Cancel)
            S.Closed = true
            for _, inst in ipairs(S.MyOfferItems) do if inst then pcall(function() inst.Parent = _Inventory end) end end
            for curKey, v in pairs(S.MyOfferCur) do if v > 0 then addBalance(CUR2BAL[curKey], v) end end
            S.MyOfferItems = {}; S.MyOfferCur = {StarsValue=0,TONValue=0,GemsValue=0}
            S.TheirOfferItems = {}; S.TheirOfferCur = {StarsValue=0,TONValue=0,GemsValue=0}
            gui.Enabled = false
            notify("TRADE","The trade was cancelled")
            addLog("TRADE_CANCEL", tostring(FAKE_TRADE_PARTNER))
            task.delay(0.2, function() gui:Destroy(); Fake=nil; FAKE_TRADE_PARTNER=nil end)
        end)
    end

    if R.Confirm then
        R.Confirm.Activated:Connect(function()
            if S.Busy or S.Closed then return end
            S.Busy=true; task.delay(0.3,function() S.Busy=false end)
            local txt = R.Confirm:FindFirstChild("Txt")
            if S.Confirmed then return end
            if not S.CancelConfirm then
                S.CancelConfirm = true
                if txt then txt.Text = "Are you sure?" end
                play(SND.Click)
                task.delay(3, function()
                    if not S.Closed and S.CancelConfirm and not S.Confirmed then
                        S.CancelConfirm = false; if txt then txt.Text = "Confirm" end
                    end
                end)
                return
            end
            S.CancelConfirm = false; S.Confirmed = true
            if txt then txt.Text = "Confirmed" end
            play(SND.Click)
            if offStroke then offStroke.Color = C.tradeGreen end
            task.delay(0.3, function()
                if not (Fake and Fake.gui == gui and not S.Closed) then return end
                local ptxt = R.Progress and R.Progress:FindFirstChild("Txt")
                if ptxt then ptxt.Text = "Partner thinking..." end
                task.wait(math.random(800, 2200) / 1000)
                if not (Fake and Fake.gui == gui and not S.Closed) then return end
                if math.random() < 0.08 then
                    play(SND.Cancel)
                    notify("TRADE", "Partner declined the trade")
                    S.Closed = true
                    for _, inst in ipairs(S.MyOfferItems) do if inst then pcall(function() inst.Parent = _Inventory end) end end
                    for curKey, v in pairs(S.MyOfferCur) do if v > 0 then addBalance(CUR2BAL[curKey], v) end end
                    gui.Enabled = false
                    task.wait(0.3)
                    gui:Destroy(); Fake=nil; FAKE_TRADE_PARTNER=nil
                    return
                end
                S.PartnerConfirmed = true
                if recStroke then recStroke.Color = C.tradeGreen end
                if R.Progress then
                    R.Progress.Visible = true
                    for i = 1, 30 do
                        if S.Closed then break end
                        if ptxt then ptxt.Text = ((30-i)/10).."s" end
                        task.wait(0.1)
                    end
                    if ptxt then ptxt.Text = "0s" end
                    task.wait(TRADE_CLOSE_EXTRA)
                    R.Progress.Visible = false
                end
                if not (Fake and Fake.gui == gui and not S.Closed) then return end
                captureLastTrade()
                local partnerName = partnerPlayer.Name or "Player"
                for curKey, v in pairs(S.MyOfferCur) do if v > 0 then addBalance(CUR2BAL[curKey], -v) end end
                for _, inst in ipairs(S.MyOfferItems) do
                    if inst then
                        pcall(removeNFTFromCfg, inst.Name, inst:GetAttribute("Unique")==true, inst:GetAttribute("Pattern"), inst:GetAttribute("Backdrop"), inst:GetAttribute("Number"))
                        pcall(function() inst:Destroy() end)
                    end
                end
                S.MyOfferItems = {}
                pcall(saveNFTs); pcall(saveExNFTs)
                for _, item in ipairs(S.TheirOfferItems) do
                    local gi = Info.Gifts[item.name]
                    if gi then
                        local v = Instance.new("StringValue")
                        v.Name = item.name
                        v:SetAttribute("Date", os.date("%m/%d/%Y"))
                        v:SetAttribute("Owner", partnerName)
                        if item.isUnique then
                            v:SetAttribute("Unique", true)
                            v:SetAttribute("Pattern", item.pattern or "Star")
                            v:SetAttribute("Backdrop", item.backdrop or "Black")
                            v:SetAttribute("Number", normalizeNumber(item.number))
                        end
                        v.Parent = _Inventory
                        pushNFT({name=item.name, isUnique=item.isUnique, pattern=item.pattern, backdrop=item.backdrop, number=item.number})
                    end
                end
                for curKey, v in pairs(S.TheirOfferCur) do if v > 0 then addBalance(CUR2BAL[curKey], v) end end
                clearScroll(R.OffScroll, true); clearScroll(R.RecScroll, false)
                clearCurrency(R.OffCurr); clearCurrency(R.RecCurr)
                if R.Heading then local h = R.Heading:FindFirstChild("Txt"); if h then h.Text = "Trading with "..partnerName end end
                if R.Confirm then local t = R.Confirm:FindFirstChild("Txt"); if t then t.Text = "Confirm" end end
                play(SND.Success); notify("TRADE","Trade completed")
                addLog("TRADE_COMPLETE", tostring(partnerName))
                S.Closed = true
                pcall(saveCur); pcall(saveNFTs); pcall(saveExNFTs); pcall(saveHist)
                gui.Enabled = false
                task.wait(0.15)
                gui:Destroy(); Fake=nil; FAKE_TRADE_PARTNER=nil
            end)
        end)
    end

    if R.OffScroll then
        local addSlot = R.OffScroll:FindFirstChild("Add")
        if addSlot then
            local b = addSlot:FindFirstChild("Button") or addSlot
            if b and b.Activated then
                b.Activated:Connect(function()
                    if S.Busy or S.Confirmed or S.Closed then return end
                    S.Busy=true; task.delay(0.15,function() S.Busy=false end)
                    if R.AddWindow then R.AddWindow.Visible = true end
                    if R.TradeWindow then R.TradeWindow.Visible = false end
                    play(SND.Click)
                end)
            end
        end
    end
    if R.Back then
        R.Back.Activated:Connect(function()
            if S.Busy or S.Closed then return end
            S.Busy=true; task.delay(0.15,function() S.Busy=false end)
            if R.AddWindow then R.AddWindow.Visible = false end
            if R.TradeWindow then R.TradeWindow.Visible = true end
            play(SND.Click)
        end)
    end
    if R.PageDef and R.PageUnq and R.Inv then
        R.PageDef.Activated:Connect(function()
            if S.Closed then return end
            local s1 = R.Inv:FindFirstChild("Scroll1"); local s2 = R.Inv:FindFirstChild("Scroll2")
            if s1 then s1.Visible = true end; if s2 then s2.Visible = false end
            if R.PageStroke then R.PageStroke.Position = UDim2.new(0,0,0.5,0) end
            play(SND.Click)
        end)
        R.PageUnq.Activated:Connect(function()
            if S.Closed then return end
            local s1 = R.Inv:FindFirstChild("Scroll1"); local s2 = R.Inv:FindFirstChild("Scroll2")
            if s1 then s1.Visible = false end; if s2 then s2.Visible = true end
            if R.PageStroke then R.PageStroke.Position = UDim2.new(0.5,0,0.5,0) end
            play(SND.Click)
        end)
    end
    if R.Add then
        R.Add.Activated:Connect(function()
            if S.Busy or S.Confirmed or S.Closed then return end
            S.Busy=true; task.delay(0.15,function() S.Busy=false end)
            local hasItems = next(S.PendingItems) ~= nil or next(S.PendingUniq) ~= nil
            local hasCur = false
            for _, v in pairs(S.PendingCur) do if v and v > 0 then hasCur = true; break end end
            if not hasItems and not hasCur then play(SND.Error); return end
            local payloadItems, payloadUniqs = {}, {}
            for inst in pairs(S.PendingItems) do table.insert(payloadItems, inst) end
            for inst in pairs(S.PendingUniq) do table.insert(payloadUniqs, inst) end
            for _, inst in ipairs(payloadItems) do if inst and inst.Parent == _Inventory then inst.Parent = nil end table.insert(S.MyOfferItems, inst) end
            for _, inst in ipairs(payloadUniqs) do if inst and inst.Parent == _Inventory then inst.Parent = nil end table.insert(S.MyOfferItems, inst) end
            for k, v in pairs(S.PendingCur) do S.MyOfferCur[k] = (S.MyOfferCur[k] or 0) + v end
            rebuildOffScroll(R, S)
            S.PendingItems={}; S.PendingUniq={}; S.PendingCur={StarsValue=0,TONValue=0,GemsValue=0}
            if R.SelScroll then for _, c in ipairs(R.SelScroll:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end end
            if R.SelCurr then
                for _, cf in ipairs({"StarsValue","TONValue","GemsValue"}) do
                    local f = R.SelCurr:FindFirstChild(cf)
                    if f then
                        local box = f:FindFirstChildOfClass("TextBox"); if box then box.Text = "" end
                        f:SetAttribute("Amount", 0)
                    end
                end
            end
            for name, data in pairs(S.InvCounters) do
                local curCnt = 0
                for _, inv in ipairs(_Inventory:GetChildren()) do if inv.Name == name and not inv:GetAttribute("Unique") then curCnt = curCnt + 1 end end
                if data.counter then data.counter.Value = curCnt end
                if data.countLbl then data.countLbl.Text = "x"..curCnt end
                if data.slot then data.slot.Visible = curCnt > 0 end
            end
            for inst, slot in pairs(S.InvUniqs) do if inst and inst.Parent == _Inventory then slot.Visible = true else slot.Visible = false end end
            if R.AddWindow then R.AddWindow.Visible = false end
            if R.TradeWindow then R.TradeWindow.Visible = true end
        end)
    end
    return gui
end

local function partnerAddItem(giftName, isUnique, pattern, backdrop, number)
    if not (Fake and Fake.gui and Fake.gui.Parent) then return false end
    local S, R = Fake.S, Fake.refs
    if S.Closed then return false end
    if not isValidGiftName(giftName) then return false end
    table.insert(S.TheirOfferItems, {
        name=giftName, isUnique=isUnique or false,
        pattern=pattern, backdrop=backdrop,
        number=isUnique and normalizeNumber(number) or number,
    })
    if isUnique then
        if R.TmplU and R.RecScroll then
            local slot = R.TmplU:Clone()
            slot.Name = giftName.."_"..tostring(math.random(1,9999))
            slot:SetAttribute("Unique", true); paintGift(slot, giftName)
            local f = slot:FindFirstChild("Folder")
            if f then
                local numL = f:FindFirstChild("Number")
                if numL then numL.Text = normalizeNumber(number) end
                if pattern and Info.Patterns and Info.Patterns[pattern] then
                    local pId = Info.Patterns[pattern]
                    local pats = f:FindFirstChild("Patterns")
                    if pats then
                        for _, img in ipairs(pats:GetChildren()) do
                            if img:IsA("ImageLabel") then img.Image = "rbxassetid://"..tostring(pId) end
                        end
                    end
                end
                if backdrop and Info.Backdrops and Info.Backdrops[backdrop] then
                    f.BackgroundColor3 = Info.Backdrops[backdrop]
                end
            end
            local b = slot:FindFirstChild("Button"); if b then b:Destroy() end
            slot.Parent = R.RecScroll
        end
    else
        if R.TmplD and R.RecScroll then
            local existing = R.RecScroll:FindFirstChild(giftName)
            if existing and existing:GetAttribute("Unique") then existing = nil end
            if existing then
                local counter = existing:FindFirstChild("Counter")
                local f = existing:FindFirstChild("Folder"); local countLbl = f and f:FindFirstChild("Count")
                local newCnt = (counter and counter.Value or 0) + 1
                if counter then counter.Value = newCnt end
                if countLbl then countLbl.Text = "x"..newCnt end
            else
                local slot = R.TmplD:Clone(); slot.Name = giftName; slot:SetAttribute("Unique", false); paintGift(slot, giftName)
                local f = slot:FindFirstChild("Folder"); local countLbl = f and f:FindFirstChild("Count"); if countLbl then countLbl.Text = "x1" end
                local counter = slot:FindFirstChild("Counter"); if counter then counter.Value = 1 end
                local b = slot:FindFirstChild("Button"); if b then b:Destroy() end
                slot.Parent = R.RecScroll
            end
        end
    end
    return true
end

local function partnerAddCurrency(curKey, amount)
    if not (Fake and Fake.gui and Fake.gui.Parent) then return false end
    local S, R = Fake.S, Fake.refs
    if S.Closed then return false end
    if amount <= 0 then return false end
    S.TheirOfferCur[curKey] = amount
    if R.RecCurr and R.TmplC then addCurrencyTo(R.RecCurr, curKey, S.TheirOfferCur[curKey], R.TmplC) end
    return true
end

-- ═══════════ UI HELPERS ═══════════
local function New(cls, props)
    local ok, o = pcall(Instance.new, cls)
    if not ok or not o then return nil end
    if props then for k, v in pairs(props) do pcall(function() o[k] = v end) end end
    return o
end
local function corner(p, r)
    if not p then return end
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or S.rMd); c.Parent = p; return c
end
local function stroke(p, color, thickness, transparency, useGradient)
    if not p then return end
    local s = Instance.new("UIStroke")
    s.Color = color or C.neonBr; s.Thickness = thickness or 1
    s.Transparency = transparency or 0.25
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = p
    if useGradient ~= false then local g = Instance.new("UIGradient"); g.Color = AQUA_SEQ; g.Parent = s end
    return s
end
local function gradient(parent, seq, rot)
