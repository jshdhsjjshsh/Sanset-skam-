local function fullNum(n)
    if Handler and Handler.SimpleNumber then
        local ok, r = pcall(Handler.SimpleNumber, n)
        if ok and r then return tostring(r) end
    end
    n = math.floor(tonumber(n) or 0)
    if n < 0 then n = 0 end
    local s = tostring(n)
    local k
    repeat s, k = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2") until k == 0
    return s
end
local sn = fullNum

local function parseNumber(str)
    if type(str) ~= "string" then return nil end
    local s = str:lower():gsub("%s", "")
    local mult, numPart = 1, s
    local _, _, suffix = s:find("([kmbtqa])$")
    if suffix then
        numPart = s:sub(1, #s - 1)
        local m = {k=1e3, m=1e6, b=1e9, t=1e12, q=1e15, a=1e18}
        mult = m[suffix] or 1
    end
    local clean = numPart:gsub("[^%d%.]", "")
    if clean == "" then return nil end
    local num = tonumber(clean)
    if not num then return nil end
    return math.floor(num * mult)
end

