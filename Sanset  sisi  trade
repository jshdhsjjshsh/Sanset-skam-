local function removeLotGroup(gid, giveNFT)
    if not gid then return end
    local restored = false
    local function check(lot)
        if lot:GetAttribute("__tpxGroup") == gid then
            if giveNFT and not restored then
                local snap = lotData[lot]
                if snap then pcall(restoreNFT, snap); restored = true end
            end
            if tonumber(lot:GetAttribute("Owner")) == 0 then
                local seller = lot:GetAttribute("OwnerName")
                removeFakeMarketRecord(lot.Name, seller, gid)
            end
            lotData[lot] = nil
            pcall(function() lot:Destroy() end)
        end
    end
    for _, c in ipairs(_Market:GetChildren()) do if c:IsA("IntValue") then check(c) end end
    for _, ck in ipairs(CURR_KEYS) do
        local f = RSMarket:FindFirstChild(ck)
        if f then for _, c in ipairs(f:GetChildren()) do if c:IsA("IntValue") then check(c) end end end
    end
    saveMarket()
end
local function removeSpecificLot(lot, giveNFT)
    if not lot or typeof(lot) ~= "Instance" then return end
    local gid = lot:GetAttribute("__tpxGroup")
    if gid then removeLotGroup(gid, giveNFT) else
        local snap = lotData[lot]
        if snap and giveNFT then pcall(restoreNFT, snap) end
        if tonumber(lot:GetAttribute("Owner")) == 0 then
            removeFakeMarketRecord(lot.Name, lot:GetAttribute("OwnerName"), nil)
        end
        lotData[lot] = nil
        pcall(function() lot:Destroy() end)
    end
end

