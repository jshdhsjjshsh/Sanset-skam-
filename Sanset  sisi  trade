    local oid = tonumber(lot:GetAttribute("Owner"))
    if oid and oid > 0 then
        local plr = Players:GetPlayerByUserId(oid)
        if plr then return plr.Name end
    end
    local gname = lot.Name
    for _, rec in ipairs(_fakeMarket) do
