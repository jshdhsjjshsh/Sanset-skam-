local function spawnConfigNFT(nft)
    if type(nft) ~= "table" or not nft.name then return end
    if not Info.Gifts[nft.name] then return end
    local v = Instance.new("StringValue")
    v.Name = nft.name; v.Value = ""
    v:SetAttribute("Date",  nft.date or os.date("%m/%d/%Y"))
    v:SetAttribute("Owner", nft.owner or LP.Name)
    if nft.isUnique then
        v:SetAttribute("Unique",   true)
        v:SetAttribute("Pattern",  nft.pattern or "Star")
        v:SetAttribute("Backdrop", nft.backdrop or "Black")
        v:SetAttribute("Number",   normalizeNumber(nft.number))
    end
    v.Parent = _Inventory
end

local function countOwned(name, isUnique, pattern, backdrop, number)
    local c = 0
    for _, item in ipairs(_Inventory:GetChildren()) do
        if item.Name == name then
            if isUnique then
                if item:GetAttribute("Unique") == true
                    and item:GetAttribute("Pattern") == pattern
                    and item:GetAttribute("Backdrop") == backdrop
                    and item:GetAttribute("Number") == number then c = c + 1 end
            else
                if item:GetAttribute("Unique") ~= true then c = c + 1 end
            end
        end
    end
    return c
end

local function restoreAllNFTs()
    local groups = {}
    local function keyFor(nft)
        if nft.isUnique then
            return tostring(nft.name).."|1|"..tostring(nft.pattern or "").."|"
                ..tostring(nft.backdrop or "").."|"..normalizeNumber(nft.number)
        else
            return tostring(nft.name).."|0"
        end
    end
    local function addGroup(nft)
        if type(nft) ~= "table" or not nft.name then return end
        if not Info.Gifts[nft.name] then return end
        local k = keyFor(nft)
        if not groups[k] then groups[k] = { count = 0, sample = nft } end
        groups[k].count = groups[k].count + 1
    end
    for _, nft in ipairs(_fakeNFTs) do addGroup(nft) end
    for _, nft in ipairs(_exNFTs)   do addGroup(nft) end

    for _, info in pairs(groups) do
        local nft = info.sample
        local num = nft.isUnique and normalizeNumber(nft.number) or nil
        local owned = countOwned(nft.name, nft.isUnique == true, nft.pattern, nft.backdrop, num)
        local need = info.count - owned
        if need > 0 then
            for _ = 1, need do spawnConfigNFT(nft) end
        end
    end
end
