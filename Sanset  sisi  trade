local function hasFileApi()
    return type(writefile)=="function" and type(readfile)=="function"
       and type(isfile)=="function" and type(isfolder)=="function"
       and type(makefolder)=="function"
end
local function ensureFolder(p) if not hasFileApi() then return end pcall(function() if not isfolder(p) then makefolder(p) end end) end
local function ensureFile(p, d) if not hasFileApi() then return end pcall(function() if not isfile(p) then writefile(p, d or "") end end) end
