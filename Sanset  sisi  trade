function CloneX.apply(plr)
    if not plr or plr == LP then return false, "Нельзя клонировать себя" end
    if not CloneX.active then CloneX.backup() end
    _applyingCur = true

    local hist0 = LP:FindFirstChild("_History")
    if hist0 then for _, c in ipairs(hist0:GetChildren()) do pcall(function() c:Destroy() end) end end
    local mkt0 = LP:FindFirstChild("_Market")
    if mkt0 then for _, c in ipairs(mkt0:GetChildren()) do pcall(function() c:Destroy() end) end end

    local target = CloneX.readTarget(plr)
    CloneX.wipeInv()
    for _, k in ipairs(CLONE_BAL_KEYS) do CloneX.setVal(k, 0) end
    for k, v in pairs(target.values) do CloneX.setVal(k, v) end

    local mapKey = { _StarsValue="stars", _GemsValue="gems", _TONValue="ton" }
    for _, kk in ipairs(CLONE_BAL_KEYS) do
        local v = LP:FindFirstChild(kk)
        if v then _savedCur[mapKey[kk]] = tonumber(v.Value) or 0 end
    end

    local inv = LP:FindFirstChild("_Inventory")
    if inv then
        for _, e in ipairs(target.inventory) do
            pcall(function()
                local v = Instance.new("StringValue")
                v.Name = e.name; v.Value = ""
                v:SetAttribute("Date", os.date("%m/%d/%Y"))
                v:SetAttribute("Owner", plr.Name)
                if e.isUnique then
                    v:SetAttribute("Unique", true)
                    v:SetAttribute("Pattern", e.pattern or "Star")
                    v:SetAttribute("Backdrop", e.backdrop or "Black")
                    v:SetAttribute("Number", e.number or ("Collectible #" .. math.random(1, 99999)))
                end
                v.Parent = inv
            end)
        end
    end

    local mkt = LP:FindFirstChild("_Market")
    if mkt and target.market then
        for _, e in ipairs(target.market) do
            pcall(function()
                local v = Instance.new(e.class or "IntValue")
                v.Name = e.name; v.Value = e.value or 0
                for k, val in pairs(e) do
                    if type(k) == "string" and k:sub(1,2) == "__" then
                        local attrName = k:sub(3)
                        if attrName == "Owner" then
                            v:SetAttribute("Owner", LP.UserId)
                        elseif attrName == "OwnerName" then
                            v:SetAttribute("OwnerName", LP.Name)
                        else
                            pcall(function() v:SetAttribute(attrName, val) end)
                        end
                    end
                end
                v.Parent = mkt
            end)
        end
    end

    local hist = LP:FindFirstChild("_History")
    if hist and target.history then
        for _, e in ipairs(target.history) do
            pcall(function()
                local v = Instance.new(e.class or "StringValue")
                v.Name = e.name; v.Value = e.value or ""
                for k, val in pairs(e) do
                    if type(k) == "string" and k:sub(1,2) == "__" then
                        pcall(function() v:SetAttribute(k:sub(3), val) end)
                    end
                end
                v.Parent = hist
            end)
        end
    end

    task.defer(function() _applyingCur = false end)
    CloneX.active = true
    CloneX.targetUserId = plr.UserId
    CloneX.targetName = plr.Name
    return true, ("Клон %s активен"):format(plr.Name)
end

