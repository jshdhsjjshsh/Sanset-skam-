local function normalizeNumber(num)
    if num == nil then return "Collectible #"..tostring(math.random(1, 99999)) end
    if type(num) == "number" then return "Collectible #"..tostring(math.floor(num)) end
    local s = tostring(num)
    if s:find("Collectible", 1, true) then return s end
    if s:match("^%d+$") then return "Collectible #"..s end
    return s
end

