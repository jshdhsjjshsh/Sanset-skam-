                if slot and isUnderMarket(slot) then pcall(function() inst:Destroy() end) end
            end
        end
    end
    pcall(function() for _, d in ipairs(PG:GetDescendants()) do killMarketCounter(d) end end)
    pcall(function() for _, d in ipairs(SG:GetDescendants()) do killMarketCounter(d) end end)
    PG.DescendantAdded:Connect(function(inst) task.defer(function() killMarketCounter(inst) end) end)
    pcall(function() SG.DescendantAdded:Connect(function(inst) task.defer(function() killMarketCounter(inst) end) end) end)
end)

