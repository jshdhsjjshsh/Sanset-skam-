local MarketRF    = Ev:WaitForChild("Market")
local TradeClient = Ev:WaitForChild("TradeClient")

if hookmetamethod and getnamecallmethod and newcclosure then
    local ok, mt = pcall(getrawmetatable, game)
    if ok and mt and mt.__namecall then
        local old = mt.__namecall
        pcall(setreadonly, mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "InvokeServer" then
                if self == MarketRF then
                    local args = {...}
                    local action = args[1]
                    if action == "Buy" then
                        local lot = args[2]
                        if lot and typeof(lot) == "Instance" and lot:IsA("IntValue") then
                            local giftName = lot.Name
                            if Info.Gifts[giftName] then
                                local oid = tonumber(lot:GetAttribute("Owner"))
                                if oid == LP.UserId then
                                    removeSpecificLot(lot, true); triggerMarketRefresh(); play(SND.Click)
                                    return false, "Это ваш собственный лот"
                                end
                                local charges = lotCharges(lot)
                                for key, v in pairs(charges) do
                                    local bal = BAL[key]
                                    if not bal or bal.Value < v then play(SND.Error); return false, "Not enough" end
                                end
                                for key, v in pairs(charges) do addBalance(key, -v) end
                                local newNFT = Instance.new("StringValue")
                                newNFT.Name = giftName; newNFT.Value = ""
                                newNFT:SetAttribute("Date",  os.date("%m/%d/%Y"))
                                newNFT:SetAttribute("Owner", LP.Name)
                                newNFT.Parent = _Inventory
                                pushNFT({name=giftName})
                                local sellerName = resolveSellerName(lot)
                                local firstCur, firstVal = nil, 0
                                for _, cKey in ipairs(CURR_KEYS) do
                                    local v = charges[cKey]
                                    if v and v > 0 then firstCur, firstVal = cKey, v; break end
                                end
                                if firstCur then recordHistory(giftName, "Bought", sellerName, firstCur, firstVal) end
                                removeSpecificLot(lot, false)
                                triggerMarketRefresh(); play(SND.Coins)
                                addLog("MARKET_BUY", giftName.." from "..sellerName)
                                task.wait(math.random(200, 500) / 1000)
                                return true, nil, giftName, firstCur or "_StarsValue", firstVal
                            end
                        end
                    end
                    if action == "PlaceOffer" then
                        local giftName = args[2]
                        local prices = args[3] or {}
                        if typeof(giftName) == "string" and Info.Gifts[giftName] then
                            local active = {}
                            for _, key in ipairs(CURR_KEYS) do
                                local v = prices[key]
                                if type(v) == "number" and v > 0 then table.insert(active, {key=key, value=math.floor(v)}) end
                            end
                            if #active == 0 then play(SND.Error); return false, "No price" end
                            local src
                            for _, inv in ipairs(_Inventory:GetChildren()) do
                                if inv.Name == giftName then src = inv; break end
                            end
                            if not src then play(SND.Error); return false, "No inv" end
                            local snap = snapshotNFT(src)
                            pcall(function() src:Destroy() end)
                            local gid = newGroupId()
                            local lp = Instance.new("IntValue")
                            lp.Name = giftName; lp.Value = 0
                            lp:SetAttribute("Owner", LP.UserId)
                            lp:SetAttribute("__tpxGroup", gid)
                            for _, c in ipairs(active) do lp:SetAttribute(c.key, c.value) end
                            lp.Parent = _Market
                            for _, c in ipairs(active) do
                                local f = RSMarket:FindFirstChild(c.key)
                                if not f then f = Instance.new("Folder"); f.Name = c.key; f.Parent = RSMarket end
                                local rl = Instance.new("IntValue")
                                rl.Name = giftName; rl.Value = c.value
                                rl:SetAttribute("Owner", LP.UserId)
                                rl:SetAttribute("__tpxGroup", gid)
                                for _, c2 in ipairs(active) do rl:SetAttribute(c2.key, c2.value) end
                                rl.Parent = f
                            end
                            if snap then
                                for _, c in ipairs(_Market:GetChildren()) do
                                    if c:GetAttribute("__tpxGroup") == gid then lotData[c] = snap end
                                end
                                for _, ck in ipairs(CURR_KEYS) do
                                    local f = RSMarket:FindFirstChild(ck)
                                    if f then
                                        for _, c in ipairs(f:GetChildren()) do
                                            if c:GetAttribute("__tpxGroup") == gid then lotData[c] = snap end
                                        end
                                    end
                                end
                            end
                            triggerMarketRefresh(); play(SND.Coins)
                            addLog("MARKET_LIST", giftName)
                            return true
                        end
                    end
                    if action == "Delete" then
                        local lot = args[2]
                        if lot and typeof(lot) == "Instance" and lot:IsA("IntValue") then
                            removeSpecificLot(lot, true); triggerMarketRefresh(); play(SND.Click)
                            return true
                        end
                    end
                end

                if self == TradeClient then
                    local args = {...}
                    local action = args[1]
                    if action == "SendRequest" then
                        local target = args[2]
                        if AUTO_TRADE_ENABLED and typeof(target)=="Instance" and target:IsA("Player") then
                            local now = os.clock()
                            local last = _lastTradeReq[target.UserId] or 0
                            if now - last < 2.5 then return false, "Слишком часто" end
                            _lastTradeReq[target.UserId] = now
                            play(SND.Request)
                            task.delay(TRADE_START_DELAY, function()
                                if Fake and Fake.gui and Fake.gui.Parent then return end
                                pcall(StartFakeTrade, target)
                            end)
                            addLog("FAKE_TRADE_INTERCEPT", tostring(target.Name))
                            return true, "Sent"
                        end
                        return old(self, ...)
                    end
                    local inFake = Fake and Fake.gui and Fake.gui.Parent
                    if inFake then
                        if action == "Cancel" then return true, "Cancelled" end
                        if action == "Confirm" then return true end
                        if action == "AddToOffer" then return true, "Added" end
                    end
                    return old(self, ...)
                end
            end
            return old(self, ...)
        end)
        pcall(setreadonly, mt, true)
    end
end

