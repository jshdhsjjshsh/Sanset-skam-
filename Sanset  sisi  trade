local function lotCharges(lot)
    local charges = {}
    if not lot then return charges end
    for _, key in ipairs(CURR_KEYS) do
        local v = lot:GetAttribute(key)
        if type(v) == "number" and v > 0 then charges[key] = v end
    end
    if next(charges) ~= nil then return charges end
    local p = lot.Parent
    if p and (p.Name=="_StarsValue" or p.Name=="_GemsValue" or p.Name=="_TONValue") then
        local v = tonumber(lot.Value) or 0
        if v > 0 then charges[p.Name] = v end
        return charges
    end
    if type(lot.Value) == "number" and lot.Value > 0 then charges["_StarsValue"] = lot.Value end
    return charges
end

