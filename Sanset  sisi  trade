local function readJSON(path, def)
    if not hasFileApi() or not isfile(path) then return def end
    local ok, raw = pcall(readfile, path)
    if not ok or type(raw) ~= "string" or raw == "" then return def end
    local ok2, data = pcall(function() return Https:JSONDecode(raw) end)
    if not ok2 then return def end
    return data
end
local function writeJSON(path, data)
    if not hasFileApi() then return end
    local ok = pcall(function() writefile(path, Https:JSONEncode(data)) end)
    if not ok then
        pcall(function() if not isfolder(CFG_FOLDER) then makefolder(CFG_FOLDER) end end)
        pcall(function() writefile(path, Https:JSONEncode(data)) end)
    end
end

